{
  "name": "zh-labs-command-center",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "chrome:build": "npm run build && node scripts/generate-update-xml.js",
    "chrome:pack": "node scripts/package-chrome.js",
    "chrome:publish": "npm run chrome:build && npm run chrome:pack && gh release create v$(node -p \"require('./package.json').version\") release/extension.zip -t \"Release v$(node -p \"require('./package.json').version\")\" -n \"Auto-generated release\"",
    "dev": "vite",
    "build": "node scripts/sync-manifest-version.js && tsc && vite build",
    "create:v": "node -p \"require('./package.json').version\"",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "autoprefixer": "^10.6.2",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.73.0",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "archiver": "^7.0.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^29.1.1",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
